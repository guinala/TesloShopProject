// use prisma-8

enum Size {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum Gender {
  men
  women
  kid
  unisex
}

model Category {
  id       Uuid      @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          Uuid     @id @default(uuid())
  title       String
  description String
  inStock     Int
  price       Float    @default(0)
  sizes       Size[]
  slug        String   @unique
  tags        String[] @default([])
  gender      Gender

  categoryId Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  images ProductImage[]

  @@index([gender])
}

model ProductImage {
  id  Int    @id @default(autoincrement())
  url String

  productId Uuid
  product   Product @relation(fields: [productId], references: [id])
}